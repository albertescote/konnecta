# Production Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Dev Supabase (optional — falls back to prod values if omitted)
DEV_SUPABASE_URL=your_dev_supabase_url
DEV_SUPABASE_ANON_KEY=your_dev_supabase_anon_key

# OneSignal
ONESIGNAL_APP_ID=your_onesignal_app_id

# Google OAuth (server client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_server_client_id.apps.googleusercontent.com

# Backend base URL
BASE_URL=https://your-custom-domain
DEV_BASE_URL=https://your-dev-domain

# Weather coordinates (defaults to Vilanova i la Geltrú if omitted)
# WEATHER_LAT=41.2856
# WEATHER_LNG=1.2504

# Signing (optional for local dev, required for release builds)
KEYSTORE_FILE=my-release-key.jks
KEYSTORE_PASSWORD=your_keystore_password
KEY_ALIAS=your_key_alias
KEY_PASSWORD=your_key_password
